{"name":"PHP","icon":"extensions","settings":"{\"settings\":\"{\\n    \\\"files.associations\\\": {\\n        \\\"*.php\\\": \\\"php\\\"\\n    },\\n    \\\"[php]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"bmewburn.vscode-intelephense-client\\\"\\n    },\\n    \\\"php.executablePath\\\": \\\"/opt/homebrew/bin/php\\\",\\n    \\\"git.autofetch\\\": true,\\n    \\\"symfony.code.snippets.hideWelcomeMessage\\\": true,\\n    \\\"workbench.colorTheme\\\": \\\"Atom One Light\\\",\\n    \\\"git.confirmSync\\\": false,\\n    \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\n    \\\"workbench.editor.autoLockGroups\\\": {\\n        \\\"default\\\": true\\n    },\\n    \\\"php.suggest.basic\\\": false,\\n    \\\"php.validate.enable\\\": false,\\n    \\\"workbench.editor.showTabs\\\": \\\"multiple\\\",\\n    \\\"workbench.editor.enablePreview\\\": false,\\n    \\\"explorer.confirmDelete\\\": false,\\n    \\\"explorer.confirmDragAndDrop\\\": false,\\n    \\\"database-client.autoSync\\\": true,\\n    \\\"makefile.configureOnOpen\\\": false,\\n    \\\"extensions.ignoreRecommendations\\\": true,\\n    \\\"window.confirmSaveUntitledWorkspace\\\": false,\\n    \\\"git.replaceTagsWhenPull\\\": true,\\n    \\\"sshfs.configs\\\": [\\n        {\\n            \\\"name\\\": \\\"unnamed\\\"\\n        }\\n    ],\\n    \\\"git.ignoreRebaseWarning\\\": true,\\n    \\\"explorer.confirmPasteNative\\\": false,\\n    \\\"[dockercompose]\\\": {\\n        \\\"editor.insertSpaces\\\": true,\\n        \\\"editor.tabSize\\\": 2,\\n        \\\"editor.autoIndent\\\": \\\"advanced\\\",\\n        \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\"\\n    },\\n    \\\"[github-actions-workflow]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-yaml\\\"\\n    },\\n    \\\"files.exclude\\\": {\\n        \\\"**/.trunk/*actions/\\\": true,\\n        \\\"**/.trunk/*logs/\\\": true,\\n        \\\"**/.trunk/*notifications/\\\": true,\\n        \\\"**/.trunk/*out/\\\": true,\\n        \\\"**/.trunk/*plugins/\\\": true\\n    },\\n    \\\"files.watcherExclude\\\": {\\n        \\\"**/.trunk/*actions/\\\": true,\\n        \\\"**/.trunk/*logs/\\\": true,\\n        \\\"**/.trunk/*notifications/\\\": true,\\n        \\\"**/.trunk/*out/\\\": true,\\n        \\\"**/.trunk/*plugins/\\\": true\\n    },\\n    \\\"editor.defaultFormatter\\\": \\\"trunk.io\\\",\\n    \\\"[json]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n    },\\n    \\\"editor.fontVariations\\\": false,\\n    \\\"[html]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.html-language-features\\\"\\n    },\\n    \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n    \\\"window.autoDetectColorScheme\\\": false,\\n    \\\"[shellscript]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"mkhl.shfmt\\\"\\n    },\\n    \\\"js/ts.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n    \\\"claudeCode.hideOnboarding\\\": true\\n}\"}","keybindings":"{\"keybindings\":\"// Place your key bindings in this file to override the defaults\\n[\\n    {\\n        \\\"key\\\": \\\"cmd+s\\\",\\n        \\\"command\\\": \\\"saveAll\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"alt+cmd+s\\\",\\n        \\\"command\\\": \\\"-saveAll\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+d\\\",\\n        \\\"command\\\": \\\"editor.action.addCommentLine\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"cmd+k cmd+c\\\",\\n        \\\"command\\\": \\\"-editor.action.addCommentLine\\\",\\n        \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n    },\\n    {\\n        \\\"key\\\": \\\"shift+cmd+o\\\",\\n        \\\"command\\\": \\\"-editor.action.accessibleViewGoToSymbol\\\",\\n        \\\"when\\\": \\\"accessibilityHelpIsShown && accessibleViewGoToSymbolSupported || accessibleViewGoToSymbolSupported && accessibleViewIsShown\\\"\\n    },\\n    {\\n        \\\"key\\\": \\