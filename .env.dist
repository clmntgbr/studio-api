PORT=3000
GO_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=86400
RATE_LIMIT_MAX=100
WORK_DIR=/tmp/work

###> postgres ###
POSTGRES_VERSION=17
POSTGRES_DB=db
POSTGRES_USER=random
POSTGRES_PASSWORD=random
POSTGRES_NAME=database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_NAME}:5432/${POSTGRES_DB}?sslmode=disable
CADDY_SITE_ADDRESS=:80
###< postgres ###

###> ngrok/ngrok ###
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
###< ngrok/ngrok ###

###> clerk/clerk-go ###
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
###< clerk/clerk-go ###

###> rabbitmq ###
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/
RABBITMQ_EXCHANGE=domain.events
RABBITMQ_QUEUE=domain.events
RABBITMQ_ROUTING_KEY=user.#,media.#
RABBITMQ_RETRY_TTL_MS=30000
WORKER_MAX_RETRIES=3
OUTBOX_POLL_INTERVAL=2s
WORKER_CONCURRENCY=4
###< rabbitmq ###

###> minio / s3 ###
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=devuser
S3_SECRET_KEY=devpassword
S3_REGION=us-east-1
S3_BUCKET_MEDIA=media
S3_BUCKET_WORK=work
S3_BUCKET_RENDERS=renders
S3_BUCKET_ASSETS=assets
# Derived media purge (cli purge retention) + renders MinIO lifecycle
RETENTION_DAYS=7
MINIO_WEBHOOK_SECRET=dev-minio-webhook-secret
###< minio / s3 ###

###> llm ###
# mock | grok | openai | deepseek | compatible
# mock replays testdata/mocks/external/llm/llm.json
LLM_PROVIDER=mock
LLM_API_KEY=
# grok defaults to https://api.x.ai/v1 — override only if needed
LLM_BASE_URL=
# grok: grok-3-mini | grok-3 | grok-2-latest — openai: gpt-4o-mini — deepseek: deepseek-chat
# groq free: qwen/qwen3.8-27b
LLM_MODEL=
LLM_PREFETCH=4
MOCK_EXTERNAL_DIR=/app/testdata/mocks/external
###< llm ###

###> scenes ###
SCENES_CONTENT_THRESHOLD=27
###< scenes ###

###> reframe ###
REFRAME_SAMPLE_FPS=5
###< reframe ###

###> ytdlp / fetch + media ###
YTDLP_BIN=yt-dlp
YTDLP_MAX_FILESIZE_MB=8000
YTDLP_MAX_DURATION_S=14400
YTDLP_MAX_HEIGHT=1080
YTDLP_COOKIES_FILE=
FETCH_CONCURRENCY=2
MEDIA_PREFETCH_PROBE=4
MEDIA_PREFETCH_AUDIO=4
MEDIA_PREFETCH_PROXY=1
MEDIA_PREFETCH_WAVEFORM=4
###< ytdlp ###

###> centrifugo/centrifugo ###
CENTRIFUGO_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000 http://localhost:3001
CENTRIFUGO_PUBLIC_WS_URL=ws://localhost:8000/connection/websocket
###< centrifugo/centrifugo ###

###> assemblyai ###
ASSEMBLYAI_API_KEY=
# assemblyai | mock (mock → testdata/mocks/external/assemblyai/words.json)
TRANSCRIBE_PROVIDER=mock
TRANSCRIBE_PREFETCH=2
TEXT_PREFETCH=4
###< assemblyai ###
